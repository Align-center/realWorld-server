{
  "name": "realworld-node-express-mongodb-javascript",
  "version": "1.0.0",
  "description": "realWorld Project",
  "main": "dist/api/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch api/index.ts",
    "start": "node dist/api/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "c8 --reporter=json --reporter=lcov --reporter=text vitest run",
    "lint:complexity": "eslint --format=json --output-file=metrics/complexity.json .",
    "type:coverage": "type-coverage -c type-coverage.config.json > metrics/type-coverage.json",
    "metrics": "npm run lint:complexity && npm run test:coverage && npm run type:coverage",
    "sandcastle": "npx tsx .sandcastle/main.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.0",
    "mongoose-unique-validator": "^6.1.1",
    "slugify": "^1.6.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@ai-hero/sandcastle": "^0.12.0",
    "@eslint/js": "^10.0.1",
    "@octokit/rest": "^22.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.3",
    "tsx": "^4.20.0",
    "type-coverage": "^2.30.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
